# Copy to .env and fill in. Only POSTGRES_PASSWORD is required.

# Password for the internal database. Use letters and digits only (no @ : / #), e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-something-long

# Port the cookbook is reachable on: http://<server-ip>:8080
COOKBOOK_PORT=8080

# Optional: Anthropic API key for reading recipe photos. Can also be set in the app's Settings page.
ANTHROPIC_API_KEY=
# Optional: model override (default claude-opus-5-5).
AI_MODEL=

# Your time zone, used for "today" in the planner and calendar.
TZ=Europe/Berlin

# Set to true if you serve the app over HTTPS (reverse proxy), so login cookies are marked Secure.
SECURE_COOKIES=false
